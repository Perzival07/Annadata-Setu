{
  "@context": {
    "as": "https://perzival07.github.io/Annadata-Setu/ns/v1#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "dcterms": "http://purl.org/dc/terms/",
    "geo": "http://www.w3.org/2003/01/geo/wgs84_pos#",
    "@version": 1.1,
    "PlotPassport": "as:PlotPassport",
    "plot_id": {
      "@id": "as:plotId",
      "@type": "xsd:string"
    },
    "lat": {
      "@id": "geo:lat",
      "@type": "xsd:double"
    },
    "lon": {
      "@id": "geo:long",
      "@type": "xsd:double"
    },
    "geohash": {
      "@id": "as:geohash",
      "@type": "xsd:string"
    },
    "district": {
      "@id": "as:district",
      "@type": "xsd:string"
    },
    "state": {
      "@id": "as:state",
      "@type": "xsd:string"
    },
    "ndvi_series": {
      "@id": "as:ndviSeries",
      "@type": "@id",
      "@container": "@list"
    },
    "inferred_crop": {
      "@id": "as:inferredCrop",
      "@type": "xsd:string"
    },
    "crop_stage_days": {
      "@id": "as:cropStageDays",
      "@type": "xsd:integer"
    },
    "cropping_history": {
      "@id": "as:croppingHistory",
      "@type": "xsd:string",
      "@container": "@list"
    },
    "soil": {
      "@id": "as:soil",
      "@type": "@id"
    },
    "weather_10d": {
      "@id": "as:weather10d",
      "@type": "@id"
    },
    "data_sources": {
      "@id": "as:dataSources",
      "@type": "xsd:string",
      "@container": "@set"
    },
    "schema_version": {
      "@id": "as:schemaVersion",
      "@type": "xsd:string"
    },
    "NdviSample": "as:NdviSample",
    "date": {
      "@id": "as:observedOn",
      "@type": "xsd:date"
    },
    "value": {
      "@id": "as:ndviValue",
      "@type": "xsd:double"
    },
    "SoilProfile": "as:SoilProfile",
    "ph": {
      "@id": "as:soilPh",
      "@type": "xsd:double"
    },
    "soc": {
      "@id": "as:soilOrganicCarbon",
      "@type": "xsd:double"
    },
    "texture": {
      "@id": "as:soilTexture",
      "@type": "xsd:string"
    },
    "source": {
      "@id": "as:source",
      "@type": "xsd:string"
    },
    "WeatherForecast": "as:WeatherForecast",
    "rh_avg": {
      "@id": "as:nightRelativeHumidityAvg",
      "@type": "xsd:integer"
    },
    "rain_mm": {
      "@id": "as:rainfallMm",
      "@type": "xsd:integer"
    },
    "temp_max": {
      "@id": "as:temperatureMaxC",
      "@type": "xsd:integer"
    },
    "disease_pressure": {
      "@id": "as:diseasePressure",
      "@type": "xsd:string"
    },
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "required": "as:required",
    "nullable": "as:nullable",
    "constraint": "as:constraint"
  },
  "@id": "https://perzival07.github.io/Annadata-Setu/schema/plot-passport.v1.jsonld",
  "@type": "owl:Ontology",
  "label": "Plot Passport",
  "comment": "Everything known about one cultivated plot, derived from its coordinates alone. The farmer declares nothing: crop, growth stage and history are inferred from satellite imagery.",
  "owl:versionInfo": "1.0",
  "dcterms:license": "https://www.apache.org/licenses/LICENSE-2.0",
  "dcterms:publisher": "Annadata Setu",
  "dcterms:modified": "2026-08-23",
  "@graph": [
    {
      "@id": "as:PlotPassport",
      "@type": "rdfs:Class",
      "label": "PlotPassport",
      "comment": "A point-in-time context record for a single plot, assembled from satellite, soil and weather sources."
    },
    {
      "@id": "as:plotId",
      "@type": "rdf:Property",
      "label": "plot_id",
      "comment": "Deterministic identifier derived from the plot's geohash. Identifies land, not a person: the record carries no personal data by design.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "geo:lat",
      "@type": "rdf:Property",
      "label": "lat",
      "comment": "WGS84 latitude of the plot centroid.",
      "domain": "as:PlotPassport",
      "range": "xsd:double",
      "required": true
    },
    {
      "@id": "geo:long",
      "@type": "rdf:Property",
      "label": "lon",
      "comment": "WGS84 longitude of the plot centroid.",
      "domain": "as:PlotPassport",
      "range": "xsd:double",
      "required": true
    },
    {
      "@id": "as:geohash",
      "@type": "rdf:Property",
      "label": "geohash",
      "comment": "7-character geohash (~150 m cell). The spatial index for every query — the reference implementation uses a document store with no radius search, so geohash prefix ranges stand in for one.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true,
      "constraint": "length = 7"
    },
    {
      "@id": "as:district",
      "@type": "rdf:Property",
      "label": "district",
      "comment": "Administrative district containing the plot.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:state",
      "@type": "rdf:Property",
      "label": "state",
      "comment": "Administrative state or province containing the plot.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:ndviSeries",
      "@type": "rdf:Property",
      "label": "ndvi_series",
      "comment": "Time-ordered NDVI observations over the plot's buffer, cloud-masked. Three years of history is what makes crop and rotation inference possible.",
      "domain": "as:PlotPassport",
      "range": "as:NdviSample",
      "required": true
    },
    {
      "@id": "as:inferredCrop",
      "@type": "rdf:Property",
      "label": "inferred_crop",
      "comment": "Crop inferred from the NDVI curve. Inferred, never declared by the farmer.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:cropStageDays",
      "@type": "rdf:Property",
      "label": "crop_stage_days",
      "comment": "Days since the current season's sowing, estimated from the NDVI curve's inflection.",
      "domain": "as:PlotPassport",
      "range": "xsd:integer",
      "required": true
    },
    {
      "@id": "as:croppingHistory",
      "@type": "rdf:Property",
      "label": "cropping_history",
      "comment": "Crops grown in preceding seasons, most recent first. Repetition indicates monoculture.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:soil",
      "@type": "rdf:Property",
      "label": "soil",
      "comment": "Soil properties at the plot.",
      "domain": "as:PlotPassport",
      "range": "as:SoilProfile",
      "required": true
    },
    {
      "@id": "as:weather10d",
      "@type": "rdf:Property",
      "label": "weather_10d",
      "comment": "Ten-day forecast for the plot.",
      "domain": "as:PlotPassport",
      "range": "as:WeatherForecast",
      "required": true
    },
    {
      "@id": "as:dataSources",
      "@type": "rdf:Property",
      "label": "data_sources",
      "comment": "Provenance for every field above. Required, not optional: an advisory that cannot name its sources cannot be audited by the state adopting it.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:schemaVersion",
      "@type": "rdf:Property",
      "label": "schema_version",
      "comment": "Version of this schema the record conforms to.",
      "domain": "as:PlotPassport",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:NdviSample",
      "@type": "rdfs:Class",
      "label": "NdviSample",
      "comment": "One cloud-masked NDVI reading for a plot on a given date."
    },
    {
      "@id": "as:observedOn",
      "@type": "rdf:Property",
      "label": "date",
      "comment": "Acquisition date of the source scene.",
      "domain": "as:NdviSample",
      "range": "xsd:date",
      "required": true
    },
    {
      "@id": "as:ndviValue",
      "@type": "rdf:Property",
      "label": "value",
      "comment": "Mean NDVI over the plot buffer, normally -1.0 to 1.0.",
      "domain": "as:NdviSample",
      "range": "xsd:double",
      "required": true,
      "constraint": "-1.0 <= value <= 1.0"
    },
    {
      "@id": "as:SoilProfile",
      "@type": "rdfs:Class",
      "label": "SoilProfile",
      "comment": "Soil properties at the plot, from a soil grid service or a district average."
    },
    {
      "@id": "as:soilPh",
      "@type": "rdf:Property",
      "label": "ph",
      "comment": "Soil pH in water.",
      "domain": "as:SoilProfile",
      "range": "xsd:double",
      "required": true
    },
    {
      "@id": "as:soilOrganicCarbon",
      "@type": "rdf:Property",
      "label": "soc",
      "comment": "Soil organic carbon, percent by mass.",
      "domain": "as:SoilProfile",
      "range": "xsd:double",
      "required": true
    },
    {
      "@id": "as:soilTexture",
      "@type": "rdf:Property",
      "label": "texture",
      "comment": "Textural class, e.g. 'loam', 'black cotton soil'.",
      "domain": "as:SoilProfile",
      "range": "xsd:string",
      "required": true
    },
    {
      "@id": "as:source",
      "@type": "rdf:Property",
      "label": "source",
      "comment": "Origin of these values.",
      "domain": "as:SoilProfile",
      "range": "xsd:string",
      "required": false
    },
    {
      "@id": "as:WeatherForecast",
      "@type": "rdfs:Class",
      "label": "WeatherForecast",
      "comment": "Forecast conditions at the plot, summarised for disease-pressure reasoning."
    },
    {
      "@id": "as:nightRelativeHumidityAvg",
      "@type": "rdf:Property",
      "label": "rh_avg",
      "comment": "Mean night-time relative humidity (%) over the next four nights. Nights, not days, and four of them: averaging a longer window flattens the humidity spike that precedes a fungal outbreak.",
      "domain": "as:WeatherForecast",
      "range": "xsd:integer",
      "required": true
    },
    {
      "@id": "as:rainfallMm",
      "@type": "rdf:Property",
      "label": "rain_mm",
      "comment": "Total forecast rainfall over the window, in millimetres.",
      "domain": "as:WeatherForecast",
      "range": "xsd:integer",
      "required": true
    },
    {
      "@id": "as:temperatureMaxC",
      "@type": "rdf:Property",
      "label": "temp_max",
      "comment": "Maximum forecast air temperature, degrees Celsius.",
      "domain": "as:WeatherForecast",
      "range": "xsd:integer",
      "required": true
    },
    {
      "@id": "as:diseasePressure",
      "@type": "rdf:Property",
      "label": "disease_pressure",
      "comment": "Qualitative summary derived from rh_avg.",
      "domain": "as:WeatherForecast",
      "range": "xsd:string",
      "required": false
    },
    {
      "@id": "as:source",
      "@type": "rdf:Property",
      "label": "source",
      "comment": "Origin of these values.",
      "domain": "as:WeatherForecast",
      "range": "xsd:string",
      "required": false
    }
  ]
}
