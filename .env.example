# P3 / Canonical Environment Configuration
# GCP & General
GCP_PROJECT_ID=annadata-setu
GCP_REGION=asia-south1
MOCK_MODE=true

# Channel Service (P1) - Port 8001
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# Cloud Translate: recovers action_text for the fallback voice script, and tells
# Hindi from Marathi when a farmer writes in Devanagari (both use that script, so
# script inspection alone cannot). Voice notes work in all four languages without
# it; only those two refinements are lost.
ENABLE_TRANSLATION=false
# Cloud Storage bucket retaining escalated photos so the human review we promise
# the farmer has something to review. Unset = photos are not retained.
MEDIA_ARCHIVE_BUCKET=
# Salt for the sender hash in archived object paths. An unsalted hash of a
# 10-digit mobile number is trivially reversible by enumeration.
MEDIA_HASH_SALT=

# Brain Service (P2) - Port 8002
# One key, or several. The free tier meters per key AND per model, so a key can
# be spent for gemini-3.6-flash while still answering on another model. Extra
# keys are tried in order when one returns 429; see brain/services/genai_pool.py.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Gemini tool use: Google Search grounding + function calling over our own
# services, run as a research pass before the diagnosis (brain/services/grounding.py).
# Off by default — it adds a Gemini round trip plus search latency per diagnosis.
ENABLE_GEMINI_TOOLS=false
GEMINI_TOOLS_BUDGET_S=20
# The model to call. Pinned rather than aliased, but configurable: gemini-2.5-flash
# was hardcoded and Google now refuses it for newly created keys, which turned
# every diagnosis into a silent escalation.
GEMINI_MODEL=gemini-3.6-flash
# How long channel waits for brain. MUST exceed GEMINI_TOOLS_BUDGET_S plus the
# decide call, or brain finishes a good diagnosis after the caller has already
# escalated it.
DIAGNOSE_TIMEOUT_S=90

# Ground Service (P3) - Port 8003
EARTH_ENGINE_SERVICE_ACCOUNT=
FIRESTORE_DATABASE_ID=(default)
# Reverse geocoding turns a dropped pin into its real district, which selects the
# telemetry fallbacks, the outbreak cluster, and the farmer's language.
#
# It works with NO configuration: OpenStreetMap's Nominatim needs no key, no
# billing and no signup. Set GOOGLE_MAPS_API_KEY only if you want Google's
# higher rate limit and SLA — it is used automatically when present.
#   GEOCODER=          auto (default): Google if keyed, else Nominatim
#   GEOCODER=nominatim force the free provider even when a key exists
#   GEOCODER=google    force Google; disables lookups if no key is set
#   GEOCODER=none      no lookups at all
GEOCODER=
GOOGLE_MAPS_API_KEY=
# Nominatim blocks generic user agents. Override if you fork this project.
NOMINATIM_USER_AGENT=

# Service URLs
CHANNEL_URL=http://localhost:8001
BRAIN_URL=http://localhost:8002
GROUND_URL=http://localhost:8003
